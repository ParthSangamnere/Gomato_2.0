# Gomato Backend Environment Variables
# Copy this to .env and fill in your values

# ── Server ──
PORT=3001

# ── MongoDB Atlas ──
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gomato?retryWrites=true&w=majority

# ── Zomato Session (filled automatically after first OTP login) ──
# These are saved to DB after login — you don't need to set them manually
ZOMATO_ACCESS_TOKEN=
ZOMATO_REFRESH_TOKEN=
ZOMATO_USER_NAME=
ZOMATO_ADDRESS_ID=
ZOMATO_CELL_ID=
ZOMATO_LAT=
ZOMATO_LNG=
ZOMATO_ENTITY_ID=
ZOMATO_PLACE_ID=
ZOMATO_CITY_ID=
